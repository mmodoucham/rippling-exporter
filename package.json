{
  "name": "rippling-exporter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "package": "npm run build && node package.mjs"
  },
  "engines": {
